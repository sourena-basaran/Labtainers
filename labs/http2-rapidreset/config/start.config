GLOBAL_SETTINGS

	# LAB_MASTER_SEED - this is the master seed string specific to this laboratory
	LAB_MASTER_SEED http2-rapidreset_student_master_seed

        # Uncomment and change to match your registry (if not labtainers)
        #REGISTRY your_registry 
        # Uncomment and change to match the registry of base images (if not labtainers)
        #BASE_REGISTRY your_registry 

        # Uncomment the following to cause the content of the lab/docs directory
        # to be collected and included in the student artifacts.
        # COLLECT_DOCS YES

# Subnet 1: Internal Backend Network (Proxy, Backend Web Service)
NETWORK INTERNAL_NET
        MASK 172.16.0.0/24
        GATEWAY 172.16.0.1

# Subnet 2: External DMZ Network (Attacker, Benign Client, Proxy)
NETWORK EXTERNAL_NET
        MASK 192.168.10.0/24
        GATEWAY 192.168.10.1

# Node 1: Backend Web Service
CONTAINER backend
	USER ubuntu
	X11 YES
	INTERNAL_NET 172.16.0.10
	TERMINALS 1

# Node 2: Edge Reverse Proxy (Connected to both external & internal networks)
CONTAINER proxy
    USER ubuntu
    X11 YES
    EXTERNAL_NET 192.168.10.2
    INTERNAL_NET 172.16.0.2
    TERMINALS 1

# Node 3: Benign Client (Realistic concurrent web traffic)
CONTAINER benign-client
    USER ubuntu
    X11 YES
    EXTERNAL_NET 192.168.10.20
    TERMINALS 1

# Node 4: Attacker Node
CONTAINER attacker
    USER ubuntu
    X11 YES
    EXTERNAL_NET 192.168.10.10
    TERMINALS 1
